# Create a Neon PostgreSQL database and paste its connection string here
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Register for a Bakong Open API token at https://api-bakong.nbc.gov.kh/
BAKONG_API_TOKEN=PASTE_YOUR_BAKONG_OPEN_API_TOKEN_HERE
BAKONG_API_URL=https://api-bakong.nbc.gov.kh

# Merchant details: use your own verified Bakong account details
BAKONG_ACCOUNT_ID=your_account@bank
MERCHANT_NAME=Tra Deposit
MERCHANT_CITY=Takeo
# For individual KHQR, provide the bank identifier only if required by the SDK setup
