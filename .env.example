# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Bakong Open API token (https://api-bakong.nbc.gov.kh/) - server side only
BAKONG_API_TOKEN=PASTE_YOUR_BAKONG_OPEN_API_TOKEN_HERE
BAKONG_API_URL=https://api-bakong.nbc.gov.kh

# YOUR OWN Bakong account that receives the money, format: name@bank
BAKONG_ACCOUNT_ID=your_name@bank
MERCHANT_NAME=Tra Deposit
MERCHANT_CITY=Phnom Penh

# Minutes before a QR expires (default 10)
QR_EXPIRE_MINUTES=10
